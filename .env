# Is file ko ".env" naam se copy karke apni values bharein (ya hosting ke "Environment Variables" mein daalein)

# Website ka asli link (email ke Approve/Reject links isi se bante hain)
BASE_URL=https://www.jaipurprivatejourneys.com

# Jis email par naye review ki mail aani chahiye
